{
  "seed": 42,
  "source_dataset": "BDD100K",
  "target_domain": "NeuroDriver_Colombia",
  "image_size": [224, 224],
  "classes": {
    "CLEAR": 0,
    "VEHICLE": 1,
    "PEDESTRIAN": 2,
    "MIXED": 3
  },
  "category_mapping": {
    "vehicle": ["car", "truck", "bus", "motorcycle"],
    "pedestrian": ["pedestrian"],
    "auxiliary": ["rider", "bicycle"]
  },
  "roi": {
    "x_min": 0.20,
    "x_max": 0.80,
    "y_min": 0.35,
    "y_max": 1.00,
    "bbox_intersection_threshold": 0.35,
    "min_bbox_area_ratio": 0.0
  },
  "experiment_subset": {
    "target_size_min": 4000,
    "target_size_max": 8000,
    "target_size_preferred": 8000
  },
  "splits": {
    "strategy": "official_train_to_train_val__official_val_to_test",
    "train_val_split_ratio": 0.85
  }
}
